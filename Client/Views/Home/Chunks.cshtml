@using Client.Models
@model List<DocumentChunk>
@{
    ViewData["Title"] = "Document Chunks";
}

<div class="container mt-4">
    <h2>📝 Document Chunks</h2>
    <p class="text-muted">Document ID: @ViewBag.DocumentId</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No chunks found. Parse the document first.</div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Total Chunks:</strong> @Model.Count
        </div>

        @foreach (var chunk in Model)
        {
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <strong>Chunk #@chunk.Index</strong>
                    <span class="badge bg-secondary float-end">@chunk.Text.Length characters</span>
                </div>
                <div class="card-body">
                    <pre style="white-space: pre-wrap; font-family: 'Courier New', monospace; font-size: 0.9em;">@chunk.Text</pre>
                </div>
            </div>
        }
    }

    <a asp-action="Versions" asp-route-documentId="@ViewBag.DocumentId" class="btn btn-secondary">← Back to Versions</a>
</div>