@using Client.Models
@model List<DocumentChunk>
@{
    ViewData["Title"] = "Version Chunks";
}

<div class="container mt-4">
    <h2>📝 Version Chunks</h2>
    <p class="text-muted">Version ID: @ViewBag.VersionId</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No chunks found. Parse the version first.</div>
    }
    else
    {
        @foreach (var chunk in Model)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Chunk #@chunk.ChunkId</strong>
                    <span class="badge bg-secondary float-end">ID: @chunk.ChunkId.ToString().Substring(0, 8)...</span>
                </div>
                <div class="card-body">
                    <pre style="white-space: pre-wrap;">@chunk.Text</pre>
                </div>
            </div>
        }
    }

    <a asp-action="Versions" asp-route-documentId="@ViewBag.DocumentId" class="btn btn-secondary">← Back to Versions</a>
</div>